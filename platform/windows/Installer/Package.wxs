<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Lore Client" Manufacturer="Lore Platform" Version="$(var.Version)"
           UpgradeCode="9a1de0b2-0b11-4e7f-92f4-5e3d8a6c2f11" Scope="perMachine">
    <SummaryInformation Description="Lore Client $(var.Version)" Manufacturer="Lore Platform" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Lore Client is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="LoreIcon" SourceFile="$(var.SharedDir)\ico\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="LoreIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/arutar/lore" />
    <Property Id="MSIFASTINSTALL" Value="7" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONFOLDER" Name="Lore" />
    </StandardDirectory>

    <Feature Id="LoreClient" Title="Lore Client" Level="1">
      <Files Directory="APPLICATIONFOLDER" Include="$(var.ClientDir)\**">
        <Exclude Files="$(var.ClientDir)\**\*.pdb" />
        <Exclude Files="$(var.ClientDir)\**\*.xml" />
        <Exclude Files="$(var.ClientDir)\runtimes\**" />
      </Files>
      <ComponentRef Id="ClientPath" />
      <ComponentRef Id="ShellRegistration" />
    </Feature>

    <Component Id="ClientPath" Directory="APPLICATIONFOLDER" Guid="4b48d34f-e2ed-45f7-a242-bdf61f0f82ce">
      <Environment Id="LorePath" Name="PATH" Action="set" Part="last" System="yes" Value="[APPLICATIONFOLDER]" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Lore\Client" Name="InstallDir" Type="string" Value="[APPLICATIONFOLDER]" KeyPath="yes" />
    </Component>

    <Component Id="ShellRegistration" Directory="APPLICATIONFOLDER" Guid="7f7a9253-e3f7-47fa-82b1-cb460ab64e13">
      <RegistryValue Root="HKLM" Key="SOFTWARE\Lore\Client\Shell" Name="Registered" Type="integer" Value="1" KeyPath="yes" />

      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{cc69a511-5c48-46bc-9a41-d14050831a93}" Value="Lore Explorer context menu" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{cc69a511-5c48-46bc-9a41-d14050831a93}\InprocServer32" Value="[APPLICATIONFOLDER]LoreShell.dll" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{cc69a511-5c48-46bc-9a41-d14050831a93}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />

      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{b056f7b6-3445-46d0-b3e3-01573d936aba}" Value="Lore modified overlay" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{b056f7b6-3445-46d0-b3e3-01573d936aba}\InprocServer32" Value="[APPLICATIONFOLDER]LoreShell.dll" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{b056f7b6-3445-46d0-b3e3-01573d936aba}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />

      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{95ecca15-ad76-4802-8f4e-37e967bf7139}" Value="Lore staged overlay" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{95ecca15-ad76-4802-8f4e-37e967bf7139}\InprocServer32" Value="[APPLICATIONFOLDER]LoreShell.dll" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{95ecca15-ad76-4802-8f4e-37e967bf7139}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />

      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{9dcc2578-1112-455a-9af7-d28f18cea2b1}" Value="Lore conflicted overlay" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{9dcc2578-1112-455a-9af7-d28f18cea2b1}\InprocServer32" Value="[APPLICATIONFOLDER]LoreShell.dll" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{9dcc2578-1112-455a-9af7-d28f18cea2b1}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />

      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{224f8e7b-61ba-4da3-97d3-6092d9c47a0b}" Value="Lore locked overlay" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{224f8e7b-61ba-4da3-97d3-6092d9c47a0b}\InprocServer32" Value="[APPLICATIONFOLDER]LoreShell.dll" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{224f8e7b-61ba-4da3-97d3-6092d9c47a0b}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />

      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{902208de-1b5a-462f-9aa7-a409d88b8042}" Value="Lore ignored overlay" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{902208de-1b5a-462f-9aa7-a409d88b8042}\InprocServer32" Value="[APPLICATIONFOLDER]LoreShell.dll" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{902208de-1b5a-462f-9aa7-a409d88b8042}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />

      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{80444c1d-93fc-4241-9af5-7eff9280985e}" Value="Lore staged and modified overlay" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{80444c1d-93fc-4241-9af5-7eff9280985e}\InprocServer32" Value="[APPLICATIONFOLDER]LoreShell.dll" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{80444c1d-93fc-4241-9af5-7eff9280985e}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />

      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{e3d52a22-7739-4a37-a35f-47a1d00f8d6f}" Value="Lore clean repository overlay" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{e3d52a22-7739-4a37-a35f-47a1d00f8d6f}\InprocServer32" Value="[APPLICATIONFOLDER]LoreShell.dll" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{e3d52a22-7739-4a37-a35f-47a1d00f8d6f}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />

      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\*\shellex\ContextMenuHandlers\Lore" Value="{cc69a511-5c48-46bc-9a41-d14050831a93}" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Directory\shellex\ContextMenuHandlers\Lore" Value="{cc69a511-5c48-46bc-9a41-d14050831a93}" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Directory\Background\shellex\ContextMenuHandlers\Lore" Value="{cc69a511-5c48-46bc-9a41-d14050831a93}" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Folder\shellex\ContextMenuHandlers\Lore" Value="{cc69a511-5c48-46bc-9a41-d14050831a93}" Type="string" />

      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ Lore Modified" Value="{b056f7b6-3445-46d0-b3e3-01573d936aba}" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ Lore Staged" Value="{95ecca15-ad76-4802-8f4e-37e967bf7139}" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ Lore Conflicted" Value="{9dcc2578-1112-455a-9af7-d28f18cea2b1}" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ Lore Locked" Value="{224f8e7b-61ba-4da3-97d3-6092d9c47a0b}" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ Lore Ignored" Value="{902208de-1b5a-462f-9aa7-a409d88b8042}" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ Lore Staged Modified" Value="{80444c1d-93fc-4241-9af5-7eff9280985e}" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\ Lore Clean" Value="{e3d52a22-7739-4a37-a35f-47a1d00f8d6f}" Type="string" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{cc69a511-5c48-46bc-9a41-d14050831a93}" Value="Lore Explorer context menu" Type="string" />
    </Component>
  </Package>
</Wix>
