<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LoreCompanion/LoreCompanion.csproj" />
  </ItemGroup>

  <!-- The live tests must run on this fork's Lore library (as the installed client does), not the
       upstream one from the LoreVcs package: only the fork signs in over plain HTTP to its own
       server and falls back to anonymous access. Build-Client.ps1 builds it into target/release. -->
  <PropertyGroup>
    <ForkLoreLibrary>$(MSBuildThisFileDirectory)../../../target/release/lore.dll</ForkLoreLibrary>
  </PropertyGroup>
  <Target Name="UseForkLoreLibrary" AfterTargets="Build" Condition="Exists('$(ForkLoreLibrary)')">
    <Copy SourceFiles="$(ForkLoreLibrary)" DestinationFiles="$(OutDir)lorelib.dll" />
  </Target>

</Project>
