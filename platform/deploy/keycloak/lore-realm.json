{
  "realm": "lore",
  "enabled": true,
  "displayName": "Lore",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": false,
  "sslRequired": "none",
  "smtpServer": {},
  "components": {},
  "clients": [
    {
      "clientId": "lore-web",
      "name": "Lore Web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/*", "http://host.docker.internal:8080/*"],
      "webOrigins": ["http://localhost:8080", "http://host.docker.internal:8080"],
      "defaultClientScopes": ["openid", "profile", "email", "groups"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/##http://host.docker.internal:8080/"
      }
    },
    {
      "clientId": "lore-native",
      "name": "Lore Native Client",
      "publicClient": true,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["openid", "profile", "groups"],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "Control plane exchange domain",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "root_domains",
            "claim.value": "[\"localhost\",\"host.docker.internal\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "Lore server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lore-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "lore-control-plane",
      "name": "Lore Control Plane Service",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "lore-service-dev-only",
      "protocolMappers": [
        {
          "name": "Lore server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lore-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "Service repository permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "lore_access",
            "claim.value": "[{\"resource_id\":\"lore-*\",\"permission\":[\"read\",\"write\",\"owner\"]}]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "groups",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.invalid",
      "firstName": "Lore",
      "lastName": "Administrator",
      "realmRoles": ["default-roles-lore"],
      "credentials": [
        {
          "type": "password",
          "value": "admin-dev-only",
          "temporary": false
        }
      ]
    }
  ]
}
