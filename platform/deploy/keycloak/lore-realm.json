{
  "realm": "lore",
  "enabled": true,
  "displayName": "Lore",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": false,
  "sslRequired": "none",
  "smtpServer": {},
  "components": {},
  "clients": [
    {
      "clientId": "lore-web",
      "name": "Lore Web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://host.docker.internal:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://host.docker.internal:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/##http://host.docker.internal:8080/"
      },
      "protocolMappers": [
        {
          "name": "Directory account ID",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "LDAP_ID",
            "claim.name": "ldap_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "Groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "lore-native",
      "name": "Lore Native Client",
      "publicClient": true,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "Directory account ID",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "LDAP_ID",
            "claim.name": "ldap_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "Control plane exchange domain",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "root_domains",
            "claim.value": "[\"localhost\",\"host.docker.internal\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "Lore server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lore-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "Groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "lore-control-plane",
      "name": "Lore Control Plane Service",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${LORE_SERVICE_CLIENT_SECRET}",
      "protocolMappers": [
        {
          "name": "Lore server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lore-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "Service repository permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "lore_access",
            "claim.value": "[{\"resource_id\":\"lore-*\",\"permission\":[\"read\",\"write\",\"owner\"]}]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.invalid",
      "firstName": "Lore",
      "lastName": "Administrator",
      "realmRoles": [
        "default-roles-lore"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${LORE_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
