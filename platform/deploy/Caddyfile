# Caddy reaches the control plane and Keycloak by their container names, or, when it runs in the
# host's network (compose.caddy-host.yaml), at the loopback ports they are published on there.

# The Keycloak administration console and the master realm are never published: Lore
# accounts are managed in the WebUI. Every site that proxies Keycloak imports this.
(keycloak_guard) {
	handle /auth/admin* {
		respond "Not found" 404
	}
	handle /auth/realms/master* {
		respond "Not found" 404
	}
}

{$LORE_PUBLIC_ADDRESS:http://host.docker.internal:8080} {
	import keycloak_guard
	handle /auth* {
		reverse_proxy {$LORE_KEYCLOAK_UPSTREAM:keycloak:8080}
	}
	handle {
		# The client's address as Caddy sees it, never one the client claims: the control plane
		# uses it for LORE_MCP=internal.
		reverse_proxy {$LORE_CONTROL_PLANE_UPSTREAM:control-plane:8080} {
			header_up X-Real-IP {client_ip}
			header_up -True-Client-IP
		}
	}
}

# Any other name or address on the HTTP port (localhost, the server's IP, a short host name) goes to
# the public address. Sign-in only works there: Keycloak issues tokens and cookies for that one
# URL. Without this block Caddy answered such requests with an empty page.
http://:{$LORE_HTTP_PORT:8080} {
	redir {$LORE_PUBLIC_URL}{uri} 302
}

# A separate authentication domain, when setup configures one (generated/caddy/auth.conf).
import /etc/caddy/conf.d/*.conf
